<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PoeRedux.Views.ConfirmDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="TitleText" Classes="title" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" Classes="secondary" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Classes="outline" IsCancel="True" IsDefault="True" />
      <Button x:Name="ConfirmButton" Classes="danger" />
    </StackPanel>
  </StackPanel>
</Window>
