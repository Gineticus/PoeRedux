<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoeRedux.ViewModels"
             x:Class="PoeRedux.Views.SwitchesView"
             x:DataType="vm:SwitchesViewModel">
  <StackPanel Spacing="6" MaxWidth="520" HorizontalAlignment="Left">
    <TextBlock Classes="secondary" Text="Turned on means removed from the game." Margin="0,0,0,8" />
    <ItemsControl ItemsSource="{Binding Switches}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SwitchItemViewModel">
          <Border Padding="0,6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Name}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
