<Window x:Class="PoeRedux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PoE Redux" Height="610" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource DarkBackground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="PoE Redux" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource DarkTextPrimary}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="UpdateNotificationButton"
                        Content="Update available"
                        Visibility="Collapsed"
                        Margin="10,0,0,0"
                        Padding="8,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#FF4CAF50"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="UpdateNotificationButton_Click"/>

                <Button x:Name="GameUpdateNotificationButton"
                        Content="Game updated, click Apply to reapply"
                        Visibility="Collapsed"
                        Margin="10,0,0,0"
                        Padding="8,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#FFFF9800"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ApplyButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Game:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource DarkTextSecondary}"/>
                <ComboBox x:Name="GameSelector"
                          Width="80"
                          FontSize="12"
                          Style="{StaticResource DarkComboBox}"
                          SelectedIndex="0"
                          SelectionChanged="GameSelector_SelectionChanged">
                    <ComboBoxItem Content="PoE 1"/>
                    <ComboBoxItem Content="PoE 2"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- GGPK Path Selection -->
        <GroupBox Grid.Row="1" Header="GGPK File Path" Margin="0,0,0,8" FontSize="12" FontWeight="SemiBold">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="GgpkPathTextBox" 
                         Grid.Column="0"
                         TextChanged="GgpkPathTextBox_TextChanged"
                         Margin="0,0,8,0"
                         FontSize="11"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1" 
                        Content="Browse..." 
                        Click="BrowseButton_Click"
                        MinWidth="80"
                        FontSize="11"/>
            </Grid>
        </GroupBox>

        <!-- Patches Section -->
        <GroupBox Grid.Row="2" Header="Available Patches" Margin="0,0,0,8" FontSize="12" FontWeight="SemiBold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Select All / None -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Select All" 
                                Click="SelectAllButton_Click" 
                                MinWidth="80"
                                FontSize="11"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Select None" 
                                Click="SelectNoneButton_Click" 
                                MinWidth="80"
                                FontSize="11"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Delete Backup"
                                Click="DeleteBackupButton_Click" 
                                MinWidth="80"
                                FontSize="11"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButton}"
                                x:Name="DeleteBackupButton"/>
                    </StackPanel>
                </Grid>

                <!-- Patches List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
                    <ItemsControl x:Name="PatchesItemsControl" VerticalAlignment="Top">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DarkTextSecondary}"/>
                                            <Border Grid.Column="1"
                                                    Height="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource DarkBorder}"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <!-- Arranges the groups themselves, one under the other. The
                                     ItemsPanel below arranges the patches inside each group. -->
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DarkBorder}"
                                        BorderThickness="0"
                                        Padding="4,3"
                                        Background="{StaticResource DarkSurface}"
                                        Margin="0,0,4,2"
                                        CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Foreground="{StaticResource DarkTextPrimary}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource DarkTextPrimary}"/>
                                                <!-- One line, or the tallest card sets the height of
                                                     every cell in its group. -->
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,1,0,0"
                                                           Foreground="{StaticResource DarkTextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Button Grid.Column="1"
                                                Click="PatchConfigButton_Click"
                                                Tag="{Binding}"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Margin="6,0,2,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding ConfigLabel}"
                                                Visibility="{Binding HasConfig, Converter={StaticResource BooleanToVisibility}}"
                                                Style="{StaticResource SecondaryButton}">
                                            <Path Data="{StaticResource GearGeometry}"
                                                  Fill="{StaticResource DarkTextPrimary}"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="3" 
                     Height="20" 
                     Margin="8,0,4,8"
                     x:Name="ProgressBar"
                     Visibility="Collapsed" />

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource DarkTextSecondary}"
                       Margin="8,0"/>

            <Button Grid.Column="1"
                    Content="Reset to Vanilla"
                    Click="ResetButton_Click"
                    MinWidth="100"
                    FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Re-download every file that differs from the patch server. Reverts edits from any tool and updates the client."
                    x:Name="ResetButton"/>

            <Button Grid.Column="2"
                    Content="View Changes"
                    Click="ViewChangesButton_Click"
                    MinWidth="100"
                    FontSize="11"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Diff the current backup's originals against the live game files."
                    x:Name="ViewChangesButton"/>

            <Button Grid.Column="3"
                    Content="Restore Original"
                    Click="RestoreButton_Click"
                    MinWidth="100"
                    FontSize="11"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    x:Name="RestoreButton"/>

            <Button Grid.Column="4"
                    Content="Apply Patches"
                    Click="ApplyButton_Click"
                    MinWidth="100"
                    FontSize="11"
                    x:Name="ApplyButton"/>
        </Grid>
    </Grid>
</Window>
