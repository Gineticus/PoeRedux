<Window x:Class="PoeRedux.ColorModsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PoeRedux.Models"
        Title="PoE Redux"
        Height="610"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource DarkBackground}">
    <Window.Resources>
        <models:InverseBooleanConverter x:Key="InverseBoolean"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Mods Colors"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DarkTextPrimary}"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0"
                   Text="Each mod picks a group. The group carries the color."
                   FontSize="11"
                   Foreground="{StaticResource DarkTextSecondary}"
                   Margin="0,22,0,12"/>
        <CheckBox x:Name="TagPrefixCheckBox"
                  Grid.Row="0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  FontSize="11"
                  Content="Color a tag instead of the whole mod"
                  ToolTip="BAD Monsters reflect Elemental Damage, with only BAD colored"
                  Foreground="{StaticResource DarkTextPrimary}"/>

        <!-- Group colors -->
        <ItemsControl x:Name="GroupsItemsControl" Grid.Row="1" Margin="0,4,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource DarkSurface}"
                            CornerRadius="3"
                            Padding="6"
                            Margin="0,0,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkTextPrimary}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                                     Width="52"
                                     FontSize="11"
                                     Margin="6,0,0,0"
                                     ToolTip="Label written before the mod in tag mode"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     FontSize="11"
                                     Margin="6,0"/>
                            <Border Grid.Column="3"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{Binding Swatch}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0">
        <TabItem Header="Selected">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource DarkScrollViewer}"
                      Margin="4,4,4,0">
            <ItemsControl x:Name="ColorModsItemsControl">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,4">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DarkTextPrimary}">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text=" ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                    <Border Height="1"
                                            Margin="0,4,0,0"
                                            Background="{StaticResource DarkBorder}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource DarkBorder}"
                                BorderThickness="0"
                                Padding="4"
                                Background="{StaticResource DarkSurface}"
                                Margin="0,0,4,2"
                                CornerRadius="2">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      FontWeight="SemiBold"
                                      FontSize="12"
                                      Foreground="{StaticResource DarkTextPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource DarkTextPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableGroups}"
                                              SelectedItem="{Binding Group}"
                                              Width="110"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource DarkComboBox}"/>
                                    <Button Content="Remove"
                                            Click="RemoveModButton_Click"
                                            Tag="{Binding}"
                                            MinWidth="60"
                                            FontSize="10"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </TabItem>

        <TabItem Header="All Mods">
            <Grid Margin="4,4,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="CatalogSearchBox"
                                 FontSize="12"
                                 Padding="6,0,58,0"
                                 TextChanged="CatalogSearchBox_TextChanged"
                                 ToolTip="Filter by stat id, displayed text or category"/>
                        <TextBlock x:Name="CatalogSearchHint"
                                   Text="Search stat id, text or category"
                                   IsHitTestVisible="False"
                                   Margin="6,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DarkTextSecondary}"/>
                        <Button x:Name="CatalogClearButton"
                                Content="Clear"
                                Click="CatalogClearButton_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0"
                                Padding="6,1"
                                FontSize="10"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                    <TextBlock x:Name="CatalogStatusText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource DarkTextSecondary}"/>
                </Grid>

                <ListBox x:Name="CatalogListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource DarkTextPrimary}"/>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource DarkTextSecondary}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableCategories}"
                                          SelectedItem="{Binding SelectedCategory}"
                                          Width="120"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          Margin="8,0"
                                          Style="{StaticResource DarkComboBox}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding ActionLabel}"
                                        Click="ToggleModButton_Click"
                                        Tag="{Binding}"
                                        MinWidth="60"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AddRemoveButton}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
        </TabControl>

        <!-- Buttons -->
        <Grid Grid.Row="3"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left"
                    Grid.Column="0"
                        Orientation="Horizontal">
                <Button x:Name="SaveConfigButton"
                        Content="Save Config"
                        MinWidth="80"
                        Click="SaveConfigButton_Click"/>
                <Button x:Name="LoadConfigButton"
                        Content="Load Config"
                        MinWidth="80"
                        Click="LoadConfigButton_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                    Grid.Column="2"
                        Orientation="Horizontal">

                <Button x:Name="SaveButton"
                        Content="Save"
                        MinWidth="80"
                        Click="SaveButton_Click"/>
                <Button x:Name="ExitButton"
                        Content="Exit"
                        MinWidth="80"
                        Click="ExitButton_Click"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
