<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- oo2core.dll is not CET-aware, see issue #29. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PoeRedux.Core\PoeRedux.Core.csproj" />
    <None Include="..\..\PoeRedux\oo2core.dll" Link="oo2core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
